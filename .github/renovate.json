{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":separateMultipleMajorReleases",
    "workarounds:bitnamiDockerImageVersioning",
    "workarounds:clamavDockerImageVersioning",
    "workarounds:nodeDockerVersioning",
    "workarounds:typesNodeVersioning",
    "workarounds:ubuntuDockerVersioning",
    "docker:pinDigests"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Paris",
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prCreation": "not-pending",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboardLabels": ["dependencies"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"],
      "commitMessagePrefix": "⬆️ MAJOR",
      "groupName": null
    },
    {
      "matchUpdateTypes": ["minor"],
      "addLabels": ["minor"],
      "commitMessagePrefix": "⬆️",
      "groupName": null
    },
    {
      "matchUpdateTypes": ["patch"],
      "addLabels": ["patch"],
      "commitMessagePrefix": "⬆️",
      "groupName": null
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"],
      "commitMessageTopic": "github-actions {{packageName}}",
      "rebaseWhen": "conflicted",
      "groupName": "{{#if isMajor}}github-actions major{{else}}{{#if isMinor}}github-actions minor{{else}}{{#if isPatch}}github-actions patch{{else}}github-actions{{/if}}{{/if}}{{/if}}"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      // "automerge": true
      "automerge": false
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchDatasources": ["docker"],
      "addLabels": ["docker-images"],
      "commitMessageTopic": "docker {{packageName}} image",
      "groupName": null
    },
    {
      // Synchronize Alpine with version in dockerfile
      "matchFileNames": ["**/Dockerfile"],
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["alpine"],
      // bumpVersions would be more appropriate, but it doesn't allow changing _ to . in the version template.
      // Instead we use postUpgradeTasks
      // "bumpVersions": [
      //   {
      //     "name": "Synchronize Alpine with version in dockerfile",
      //     "filePatterns": ["**/renovate.json"],
      //     "bumpType": "sync",
      //     "matchStrings": [
      //       "\"packageNameTemplate\":\\s*\"alpine_(?<version>[0-9]{1}_[0-9]{2})/\\{\\{package\\}\\}\""
      //     ]
      //   }
      // ],
      "postUpgradeTasks": {
        "commands": [
          "sed -i -E 's/alpine_[0-9]+.[0-9]+/alpine_{{{newMajor}}}_{{{newMinor}}}/' .github/renovate.json"
        ],
        "fileFilters": [".github/renovate.json"],
        "executionMode": "branch"
      },
      "groupName": null
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["repology"],
      "addLabels": ["packages"],
      "commitMessageTopic": "package {{depName}}",
      "groupName": null
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-tags"],
      "matchDepNames": ["DockerGen"],
      "addLabels": ["app"],
      "commitMessagePrefix": "✨",
      "commitMessageTopic": "app {{depName}}",
      "groupName": null
    },
    {
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "matchUpdateTypes": ["pin", "pinDigest"],
      "addLabels": ["pin"],
      "commitMessagePrefix": "📌",
      "groupName": "pin-dependencies",
      // "automerge": true
      "automerge": false
    }
  ],

  "internalChecksFilter": "none",
  "internalChecksAsSuccess": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "datasourceTemplate": "repology",
      "packageNameTemplate": "alpine_3_23/{{package}}",
      "depNameTemplate": "{{package}}",
      "matchStrings": [
        "\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s"
      ],
      "versioningTemplate": "apk"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "nginx-proxy/docker-gen",
      "depNameTemplate": "DockerGen",
      "matchStrings": [
        "(ARG)\\s(DOCKER_GEN.*_VERSION)=\"(?<currentValue>[0-9]+\\.[0-9]+(\\.[0-9]+){0,1})\"\\n"
      ],
      "versioningTemplate": "semver"
    }
  ],

  "logLevelRemap": [
    {
      "matchMessage": "/bumpVersions/",
      "newLogLevel": "debug"
    }
  ]
}
