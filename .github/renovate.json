{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":separateMultipleMajorReleases",
    "workarounds:bitnamiDockerImageVersioning",
    "workarounds:clamavDockerImageVersioning",
    "workarounds:nodeDockerVersioning",
    "workarounds:typesNodeVersioning",
    "workarounds:ubuntuDockerVersioning",
    "docker:pinDigests"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Paris",
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prCreation": "not-pending",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboardLabels": ["dependencies"],
  "packageRules": [
    {
      "matchUpdateTypes": ["pin", "pinDigest"],
      "addLabels": ["pin"],
      "commitMessagePrefix": "📌",
      "groupName": "pin-dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pin", "pinDigest"],
      "addLabels": ["pin"],
      "commitMessagePrefix": "📌",
      "groupName": "pin-github-action"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"],
      "commitMessagePrefix": "⬆️ MAJOR",
      "commitMessageTopic": "github-actions {{packageName}}",
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor"],
      "addLabels": ["minor"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "github-actions {{packageName}}",
      "groupName": "github-actions minor",
      "rebaseWhen": "conflicted",
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch"],
      "addLabels": ["patch"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "github-actions {{packageName}}",
      "groupName": "github-actions patch",
      "rebaseWhen": "conflicted",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "addLabels": ["docker-images"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "docker {{packageName}} image"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["repology"],
      "addLabels": ["packages"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "package {{depName}}",
      "groupName": "internal packages"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-tags"],
      "matchDepNames": ["DockerGen"],
      "addLabels": ["app"],
      "commitMessagePrefix": "✨",
      "commitMessageTopic": "package {{depName}}"
    }
  ],

  "internalChecksFilter": "none",
  "internalChecksAsSuccess": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "datasourceTemplate": "repology",
      "packageNameTemplate": "alpine_3_24/{{package}}",
      "depNameTemplate": "{{package}}",
      "matchStrings": [
        "\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s"
      ],
      "versioningTemplate": "apk"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "nginx-proxy/docker-gen",
      "depNameTemplate": "DockerGen",
      "matchStrings": [
        "(ARG)\\s(DOCKER_GEN.*_VERSION)=\"(?<currentValue>[0-9]+\\.[0-9]+(\\.[0-9]+){0,1})\"\\n"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
